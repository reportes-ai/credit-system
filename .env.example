# ═══════════════════════════════════════════════════════════════════════════
#  AutoFácil Business Suite — Variables de entorno
#
#  Inventario COMPLETO de lo que el código consume (auditoría 03-08-2026, A-4).
#  Antes acá figuraban 7 de 44: replicar el entorno era adivinar, y una variable
#  faltante no rompe con estruendo — la funcionalidad simplemente no anda.
#
#  Al arrancar, el sistema informa en el log qué falta (shared/env-check.js):
#    · CRÍTICA    → el proceso NO parte
#    · IMPORTANTE → parte, pero ese módulo queda fuera de servicio
#    · OPCIONAL   → parte y degrada de forma controlada
#
#  En Render se cargan en Environment → Environment Variables (nunca en el repo).
# ═══════════════════════════════════════════════════════════════════════════

# ─── BASE DE DATOS (CRÍTICA) ───────────────────────────────────────────────
# TiDB Cloud en producción. Sin esto no hay sistema.
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=credit_system

# ─── AMBIENTE (IMPORTANTE) ─────────────────────────────────────────────────
# `staging` activa los blindajes del ambiente de pruebas (shared/entorno.js):
# Modo Desarrollo FORZADO, motores automáticos apagados y cinta visual STAGING.
# Vacía o `produccion` = comportamiento normal. En el servicio de staging de
# Render esta variable es OBLIGATORIA — es lo único que impide que ese ambiente
# le escriba a un cliente real.
ENTORNO=produccion
# Solo para scripts/crear-bd-staging.js: nombre de la base espejo a construir.
DB_NAME_STAGING=credit_system_staging

# ─── MOTORES AUTOMÁTICOS (IMPORTANTE en un host de contingencia) ────────────
# `off` levanta el proceso SIN programar ni un motor de negocio: atiende
# peticiones pero no aprueba comisiones, no genera devengos, no escala tickets
# ni cierra castigos. Es lo que permite tener un host alternativo encendido y
# probado sin que duplique el trabajo del principal — dos procesos contra la
# MISMA base ejecutarían cada reloj dos veces, y una comisión aprobada dos
# veces no avisa. El día del traspaso se quita la variable y el standby toma
# el control. Las tareas de infraestructura (uptime, limpieza de memoria)
# corren igual. Cualquier valor distinto de `off` = comportamiento normal.
MOTORES=

# ─── SERVIDOR (CRÍTICA) ────────────────────────────────────────────────────
PORT=3000
# El código la fuerza a America/Santiago; no cambiar sin leer el gotcha de
# mysql2 en la Documentación Técnica (el timezone del pool debe calzar).
TZ=America/Santiago
# Techo de memoria informado por Render (solo para el informe de Salud del Sistema)
RENDER_MEM_MB=2048

# ─── SEGURIDAD (CRÍTICA) ───────────────────────────────────────────────────
# Clave larga y aleatoria. STAGING DEBE TENER UNA DISTINTA de producción: así un
# token de staging jamás sirve en producción ni al revés.
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
# Origen permitido para CORS (si falta, se usa el dominio oficial por defecto)
CORS_ORIGIN=https://afbs.autofacilchile.cl
# URL base para armar enlaces en correos y certificados con QR
APP_URL=https://afbs.autofacilchile.cl

# ─── CORREO — Brevo SMTP (IMPORTANTE) ──────────────────────────────────────
# Sin esto no sale ningún correo: cartolas, alertas, cobranza, certificados.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=AutoFácil <no-reply@autofacilchile.cl>
MAIL_FROM_COBRANZA=Cobranza AutoFácil <cobranza@autofacilchile.cl>
MAIL_REPLY_TO=contacto@autofacilchile.cl
# Destino de la alerta automática ante cada error 500 en producción
ALERTA_ERRORES_MAIL=

# ─── MODO DESARROLLO — RESPALDO (IMPORTANTE) ───────────────────────────────
# Casillas a las que se redirige TODO si el Modo Desarrollo queda activo por
# fail-safe y la BD no responde (auditoría B-1). Separadas por coma.
# Si queda vacío el sistema simplemente NO envía, que también es seguro.
DEV_CORREOS_FALLBACK=

# ─── WHATSAPP — Meta Cloud API (IMPORTANTE) ────────────────────────────────
# Sin esto el bot Facilito y las campañas quedan en modo simulado.
# EN STAGING: vacías o con un número de prueba. JAMÁS el número real.
WSP_TOKEN=
WSP_PHONE_ID=
WSP_VERIFY=

# ─── INDICADORES CMF (IMPORTANTE) ──────────────────────────────────────────
# UF, UTM, dólar y TMC. Sin esto no se sincronizan y se usa lo último cargado.
CMF_API_KEY=

# ─── DEALERNET — informes comerciales (IMPORTANTE) ─────────────────────────
# Servicio SOAP. Cada consulta se paga: la caché de 15 días evita duplicados.
DEALERNET_ENDPOINT=https://infows.dealernet.cl
DEALERNET_USER=
DEALERNET_PASS=
DEALERNET_TIPOCNS=

# ─── INTELIGENCIA ARTIFICIAL — Anthropic (OPCIONAL) ────────────────────────
# Lectura de PDFs, informes y análisis. Si falta, el sistema degrada con aviso.
ANTHROPIC_API_KEY=

# ─── GOOGLE (OPCIONAL) ─────────────────────────────────────────────────────
# Mapa de dealers
GOOGLE_MAPS_API_KEY=
# Calendario de Mi Día — OAuth por usuario
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Calendario centralizado por cuenta de servicio (alternativa al OAuth)
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_SA_JSON_B64=

# ─── SII / FACTURACIÓN ELECTRÓNICA (OPCIONAL) ──────────────────────────────
SII_RUT_EMPRESA=
SII_RUT_USUARIO=
SII_CLAVE=
SII_CERT_B64=
SII_CERT_PASS=
# SimpleAPI — lectura del Registro de Compras y Ventas del SII
SIMPLEAPI_KEY=

# ─── OTRAS INTEGRACIONES (OPCIONAL) ────────────────────────────────────────
# Fintoc — cartola bancaria automática
FINTOC_SECRET_KEY=
# Workera — reloj control
WORKERA_API_USER=
WORKERA_API_KEY=
